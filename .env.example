# Required for direct docker compose use.
# dev-init.sh writes these automatically for each target repo.
HOST_REPO_PATH=/absolute/path/to/your/repo
WAYLAND_SOCKET_PATH=/run/user/1000/wayland-0

# Optional overrides
COMPOSE_PROJECT_NAME=emacs-opencode-myrepo
CONTAINER_USER=dev
OPENCODE_NPM_PACKAGE=opencode-ai

# If unset, scripts/dev-up.sh auto-detects id -u / id -g.
HOST_UID=1000
HOST_GID=1000

# Optional explicit workspace name in container; defaults to basename(HOST_REPO_PATH).
# WORKSPACE_DIRNAME=myrepo

# Shared OpenCode auth/data and config. Defaults are set by scripts/dev-up.sh.
# HOST_OPENCODE_SHARE_DIR=~/.local/share/opencode
# HOST_OPENCODE_CONFIG_DIR=~/.config/opencode

# Common home mounted into the container for Bash and Emacs startup.
# HOST_COMMON_HOME=~/.opencode-common-home

# Optional read-only SSH mount. Defaults to ~/.ssh during dev-up.sh.
# HOST_SSH_DIR=~/.ssh

# Optional model default. Repo .env wins over HOST_COMMON_HOME/.opencode-common.env.
# OPENCODE_MODEL=gpt-5

# Optional host cache paths. Defaults are set by scripts/dev-up.sh.
# HOST_CACHE_DIR=~/.cache
# HOST_NPM_CACHE_DIR=~/.npm
# HOST_PNPM_STORE_DIR=~/.local/share/pnpm/store
# HOST_PNPM_HOME_DIR=~/.local/share/pnpm
# HOST_PIP_CACHE_DIR=~/.cache/pip

# Optional resource limits consumed by docker-compose.yml.
# CPU_LIMIT=4
# MEM_LIMIT=8g
# PIDS_LIMIT=512
